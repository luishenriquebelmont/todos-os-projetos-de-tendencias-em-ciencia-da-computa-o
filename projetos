STOPWORDS = {"o", "a", "os", "as", "um", "uma", "uns", "umas", "de", "do", "da", "dos", "das", "em", "no", "na", "nos", "nas", "por", "para", "com", "e", "é", "devem", "ser", "em", "até"}

# ==========================================
# FASE 1: PRÉ-PROCESSAMENTO
# ==========================================
def preprocess(text):
    text = text.lower()
    text = re.sub(r'[^\w\s-]', '', text) # Mantém hifens para códigos como CÓD-ECG-12D
    tokens = text.split()
    tokens = [t for t in tokens if t not in STOPWORDS]
    return tokens

tokenized_corpus = [preprocess(doc['conteudo']) for doc in CORPUS]
doc_texts = [doc['conteudo'] for doc in CORPUS]

# Cache dos embeddings dos documentos (Fase 3)
@st.cache_data
def get_doc_embeddings():
    return bi_encoder.encode(doc_texts)

doc_embeddings = get_doc_embeddings()

def get_ranks(scores):
    """Transforma scores em rankings (1 a N), onde 1 é o maior score."""
    ranked_indices = np.argsort(scores)[::-1]
    ranks = np.zeros_like(scores)
    for rank, idx in enumerate(ranked_indices):
        ranks[idx] = rank + 1
    return ranks

# ==========================================
# UI DO STREAMLIT
# ==========================================
st.set_page_config(page_title="HealthSearch", layout="wide")
st.title("⚕️ HealthSearch: Motor de Busca Híbrido")

# SIDEBAR: FASE 2 e 4 (Parâmetros)
st.sidebar.header("Parâmetros do Motor")
k1 = st.sidebar.slider("Saturação BM25 (k1)", 0.0, 3.0, 1.2, 0.1)
b = st.sidebar.slider("Normalização BM25 (b)", 0.0, 1.0, 0.75, 0.05)
alpha = st.sidebar.slider("Peso RRF (α) [1=Léxico, 0=Semântico]", 0.0, 1.0, 0.5, 0.1)
use_cross_encoder = st.sidebar.checkbox("Ativar Cross-Encoder (Re-Ranking Top 3) [+Bônus]")

query = st.text_input("Digite sua busca médica (ex: 'protocolo eletrocardiograma', 'AVC agudo'):")

if query:
    # 1. Processar Query
    tokenized_query = preprocess(query)
    query_embedding = bi_encoder.encode([query])

    # 2. Motor Léxico (BM25)
    bm25 = BM25Okapi(tokenized_corpus, k1=k1, b=b)
    lexical_scores = bm25.get_scores(tokenized_query)
    lexical_ranks = get_ranks(lexical_scores)

    # 3. Motor Semântico (Vetorial)
    semantic_scores = cosine_similarity(query_embedding, doc_embeddings)[0]
    semantic_ranks = get_ranks(semantic_scores)

    # 4. Fusão RRF (Reciprocal Rank Fusion)
    k_rrf = 60
    rrf_scores = []
    for i in range(len(CORPUS)):
        score_rrf = (alpha * (1 / (k_rrf + lexical_ranks[i]))) + ((1 - alpha) * (1 / (k_rrf + semantic_ranks[i])))
        rrf_scores.append(score_rrf)
    
    rrf_ranks = get_ranks(rrf_scores)

    # Montando DataFrame Base
    df_results = pd.DataFrame({
        "ID": [d['id'] for d in CORPUS],
        "Título": [d['titulo'] for d in CORPUS],
        "Trecho": [d['conteudo'] for d in CORPUS],
        "Score BM25": lexical_scores,
        "Rank BM25": lexical_ranks,
        "Score Semântico": semantic_scores,
        "Rank Semântico": semantic_ranks,
        "Score RRF": rrf_scores,
        "Rank RRF": rrf_ranks
    })

    # 5. Desafio Bônus (Cross-Encoder Re-Ranking)
    if use_cross_encoder:
        # Pega os Top 3 do RRF
        top3_indices = np.argsort(rrf_scores)[::-1][:3]
        pairs = [[query, CORPUS[i]['conteudo']] for i in top3_indices]
        ce_scores = cross_encoder.predict(pairs)
        
        # Mapeando os novos scores
        df_results["Score Cross-Encoder"] = None
        df_results["Rank Final (CE)"] = df_results["Rank RRF"] # Default fallback
        
        for idx_in_top3, original_idx in enumerate(top3_indices):
            df_results.at[original_idx, "Score Cross-Encoder"] = ce_scores[idx_in_top3]
        
        # Re-rankeando os top 3
        top3_ce_ranks = np.argsort(ce_scores)[::-1]
        for new_rank, idx_in_top3 in enumerate(top3_ce_ranks):
            original_idx = top3_indices[idx_in_top3]
            df_results.at[original_idx, "Rank Final (CE)"] = new_rank + 1

        sort_col = "Rank Final (CE)"
    else:
        sort_col = "Rank RRF"

    # ==========================================
    # ABAS DA INTERFACE
    # ==========================================
    tab1, tab2, tab3, tab4 = st.tabs(["Léxico (BM25)", "Semântico (Vetorial)", "Híbrido RRF", "Matriz Comparativa"])

    with tab1:
        st.subheader("Resultados - Motor Léxico (Frequência e Saturação)")
        st.dataframe(df_results.sort_values("Rank BM25")[["Rank BM25", "ID", "Título", "Score BM25", "Trecho"]], use_container_width=True)

    with tab2:
        st.subheader("Resultados - Motor Semântico (Similaridade de Cosseno)")
        st.dataframe(df_results.sort_values("Rank Semântico")[["Rank Semântico", "ID", "Título", "Score Semântico", "Trecho"]], use_container_width=True)

    with tab3:
        st.subheader("Resultados - Fusão Híbrida (RRF)")
        if use_cross_encoder:
            st.success("Re-Ranking Cross-Encoder aplicado aos Top-3!")
            st.dataframe(df_results.sort_values(sort_col)[["Rank Final (CE)", "Rank RRF", "ID", "Título", "Score RRF", "Score Cross-Encoder", "Trecho"]], use_container_width=True)
        else:
            st.dataframe(df_results.sort_values(sort_col)[["Rank RRF", "ID", "Título", "Score RRF", "Trecho"]], use_container_width=True)

    with tab4:
        st.subheader("Matriz Comparativa de Rankings")
        st.markdown("Comparação de como cada documento perfomou nos diferentes motores.")
        st.dataframe(df_results[["ID", "Título", "Rank BM25", "Rank Semântico", "Rank RRF"]].sort_values("Rank RRF"), use_container_width=True)
        st.bar_chart(df_results.set_index("ID")[["Rank BM25", "Rank Semântico", "Rank RRF"]].iloc[::-1]) # Gráfico invertido para melhor visualização
