def comparar_pares(idx1, idx2):
    i, j = indices.index(idx1), indices.index(idx2)
    sim_bow = cosine_similarity([X_bow[i]], [X_bow[j]])[0][0]
    sim_tfidf = cosine_similarity([X_tfidf[i]], [X_tfidf[j]])[0][0]
    sim_emb = cosine_similarity([X_emb[i]], [X_emb[j]])[0][0]
    
    print(f"Par: {idx1} x {idx2}")
    print(f"BoW: {sim_bow:.4f} | TF-IDF: {sim_tfidf:.4f} | Embeddings: {sim_emb:.4f}\n")

