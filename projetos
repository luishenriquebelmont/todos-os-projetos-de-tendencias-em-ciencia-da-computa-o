 # ==========================================  # ==========================================  # ==========================================  # ==========================================

 import seaborn as sns
import matplotlib.pyplot as plt

# Usando X_emb e textos do código anterior...

def detectar_duplicatas(textos, embeddings, limiar=0.85):
    matriz_sim = cosine_similarity(embeddings)
    duplicatas = []
    n = len(textos)
    
    for i in range(n):
        for j in range(i+1, n):
            if matriz_sim[i][j] >= limiar:
                duplicatas.append((i, j, matriz_sim[i][j]))
                
    return matriz_sim, duplicatas

matriz_sim, pares_duplicados = detectar_duplicatas(textos, X_emb, limiar=0.85)

