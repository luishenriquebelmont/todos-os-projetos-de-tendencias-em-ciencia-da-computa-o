# Stopwords hardcoded (básico em português)
STOPWORDS = {
    "a", "o", "as", "os", "de", "da", "do", "das", "dos", "para", "com", "na", 
    "no", "nas", "nos", "em", "um", "uma", "uns", "umas", "e", "que", "é", "por", 
    "durante", "pode", "ser", "feito", "ou"
}

# ==========================================
# 1. FASE 1: PIPELINE DE PRÉ-PROCESSAMENTO
# ==========================================
def remove_accents(text):
    nfkd = unicodedata.normalize('NFKD', text)
    return "".join([c for c in nfkd if not unicodedata.combining(c)])

def naive_stemmer(word):
    """Stemmer didático 'from scratch' (remove sufixos comuns do plural/verbos)"""
    suffixes = ['oes', 'oes', 'cao', 'ando', 'endo', 'indo', 's']
    for suffix in suffixes:
        if word.endswith(suffix) and len(word) > len(suffix) + 2:
            return word[:-len(suffix)]
    return word

def preprocess(text, use_stopwords=True, use_stemming=True):
    # 1. Normalização (Lowercasing e sem acentos)
    text = remove_accents(text).lower()
    # 2. Tokenização (apenas palavras alfanuméricas)
    tokens = re.findall(r'\b[a-z0-9]+\b', text)
    
    # 3. Stopwords
    if use_stopwords:
        tokens = [t for t in tokens if t not in STOPWORDS]
        
    # 4. Stemming
    if use_stemming:
        tokens = [naive_stemmer(t) for t in tokens]
        
    return tokens

# ==========================================
# UI DO STREAMLIT
# ==========================================
st.set_page_config(page_title="AgroSearch", layout="wide")
st.title("🌱 AgroSearch: Motor de Busca Inteligente")
st.markdown("Protótipo de busca vetorial textual com TF-IDF implementado from scratch.")

# Exibição dos documentos originais
with st.expander("Ver Base de Documentos Original"):
    for d_id, text in DOCS.items():
        st.write(f"*Doc {d_id}:* {text}")

# --- FASE 1 ---
st.header("Fase 1: Pré-processamento")
col1, col2 = st.columns(2)
use_stopwords = col1.checkbox("Ativar Remoção de Stopwords", value=True)
use_stemming = col2.checkbox("Ativar Stemming", value=True)

# Processando documentos dinamicamente
processed_docs = {}
for doc_id, text in DOCS.items():
    processed_docs[doc_id] = preprocess(text, use_stopwords, use_stemming)

with st.expander("Ver Tokens Processados por Documento"):
    st.json(processed_docs)

# --- FASE 2 ---
st.header("Fase 2: Índice Invertido")
inverted_index = defaultdict(list)
for doc_id, tokens in processed_docs.items():
    for token in set(tokens): # Usamos set para pegar a presença do termo no documento
        inverted_index[token].append(doc_id)

with st.expander("Ver Índice Invertido (Termo -> IDs de Docs)"):
    st.json(dict(inverted_index))

# --- FASE 3 ---
st.header("Fase 3: Busca e Ranqueamento (TF-IDF)")
query = st.text_input("Digite sua consulta (ex: 'irrigação soja' ou 'lagartas'):")

if query:
    query_tokens = preprocess(query, use_stopwords, use_stemming)
    st.write(f"*Query processada:* {query_tokens}")
    
    N = len(DOCS)
    scores = defaultdict(float)
    
    # Pre-calculando TF para todos os documentos
    tf_docs = {}
    for doc_id, tokens in processed_docs.items():
        counts = Counter(tokens)
        total = len(tokens)
        tf_docs[doc_id] = {k: v/total for k, v in counts.items()}
        
    # Pre-calculando IDF para o vocabulário (apenas os necessários)
    idf = {}
    for term in query_tokens:
        if term in inverted_index:
            df = len(inverted_index[term])
            idf[term] = math.log10(N / df)
            
    # Calculando score final
    for term in query_tokens:
        if term in inverted_index:
            for doc_id in inverted_index[term]:
                tf = tf_docs[doc_id][term]
                tf_idf = tf * idf[term]
                scores[doc_id] += tf_idf
                
    # Exibindo Resultados
    if scores:
        results = []
        for doc_id, score in sorted(scores.items(), key=lambda x: x[1], reverse=True):
            results.append({
                "Rank": len(results) + 1,
                "Doc ID": doc_id,
                "Score (TF-IDF)": round(score, 4),
                "Trecho Relevante": DOCS[doc_id]
            })
            
        st.dataframe(results, use_container_width=True)
        st.success(f"🏆 Vencedor: O *Doc {results[0]['Doc ID']}* é o mais relevante para sua busca!")
    else:
        st.warning("Nenhum documento relevante encontrado para esta busca.")

