import streamlit as st
import pandas as pd
import re
import numpy as np
from rank_bm25 import BM25Okapi
from sentence_transformers import SentenceTransformer, CrossEncoder
from sklearn.metrics.pairwise import cosine_similarity

# ==========================================
# CACHE DE MODELOS (Evita recarregar a cada clique)
# ==========================================
@st.cache_resource
def load_models():
    # Modelo Semântico (Multilíngue para português)
    bi_encoder = SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')
    # Modelo Cross-Encoder para Re-Ranking (Bônus)
    cross_encoder = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')
    return bi_encoder, cross_encoder

bi_encoder, cross_encoder = load_models()

# ==========================================
# BASE DE DADOS E CONFIGURAÇÕES INICIAIS
# ==========================================
CORPUS = [
    {"id": "Doc 1", "titulo": "Protocolo Emergência ECG", "conteudo": "Pacientes com dor precordial aguda e suspeita de síndrome coronariana devem realizar eletrocardiograma CÓD-ECG-12D em até 10 minutos."},
